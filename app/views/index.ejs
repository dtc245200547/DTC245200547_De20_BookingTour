<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Hệ thống Đặt Tour Du lịch</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { background-color: #f8f9fa; }
        .tour-card { margin-bottom: 20px; transition: transform 0.2s; }
        .tour-card:hover { transform: translateY(-5px); }
        .itinerary-list { font-size: 0.9em; }
    </style>
</head>
<body>
    <div class="container my-5">
        <h1 class="text-center mb-5 text-primary fw-bold">HỆ THỐNG ĐẶT TOUR DU LỊCH</h1>
        
        <!-- Phần 1: Danh sách Tour -->
        <section class="mb-5">
            <h2 class="mb-4 text-secondary">1. Danh sách Tour & Lịch trình</h2>
            <div class="row">
                <% tours.forEach(function(tour) { %>
                    <div class="col-md-6">
                        <div class="card tour-card shadow-sm h-100 border-0">
                            <div class="card-header bg-info text-white text-center py-3">
                                <h4 class="card-title mb-0"><%= tour.name %></h4>
                            </div>
                            <div class="card-body">
                                <p class="card-text text-muted mb-2"><%= tour.description %></p>
                                <h5 class="text-danger fw-bold mb-3">Giá: $<%= tour.price %></h5>
                                <hr>
                                <h6><span class="badge bg-secondary">Lịch trình chi tiết</span></h6>
                                <ul class="list-group list-group-flush itinerary-list mt-2">
                                    <% tour.itineraries.forEach(function(it) { %>
                                        <li class="list-group-item px-0">
                                            <strong class="text-primary">Ngày <%= it.day_number %>:</strong> <%= it.activity %>
                                        </li>
                                    <% }); %>
                                    <% if(tour.itineraries.length === 0) { %>
                                        <li class="list-group-item px-0 text-muted">Chưa cập nhật lịch trình</li>
                                    <% } %>
                                </ul>
                            </div>
                        </div>
                    </div>
                <% }); %>
            </div>
        </section>

        <!-- Phần 2: Form Đặt Tour -->
        <section class="mb-5 bg-white p-4 p-md-5 rounded shadow-sm border border-light">
            <h2 class="mb-4 text-secondary">2. Đăng ký Đặt Tour</h2>
            <form action="/book" method="POST">
                <div class="row mb-4">
                    <div class="col-md-6 mb-3 mb-md-0">
                        <label for="customer_name" class="form-label fw-bold">Họ và tên *</label>
                        <input type="text" class="form-control" id="customer_name" name="customer_name" placeholder="Ví dụ: Nguyễn Văn A" required>
                    </div>
                    <div class="col-md-6">
                        <label for="customer_email" class="form-label fw-bold">Email *</label>
                        <input type="email" class="form-control" id="customer_email" name="customer_email" placeholder="example@gmail.com" required>
                    </div>
                </div>
                <div class="row mb-4">
                    <div class="col-md-4 mb-3 mb-md-0">
                        <label for="phone_number" class="form-label fw-bold">Số điện thoại *</label>
                        <input type="tel" class="form-control" id="phone_number" name="phone_number" placeholder="0912345678" required>
                    </div>
                    <div class="col-md-5 mb-3 mb-md-0">
                        <label for="tour_id" class="form-label fw-bold">Chọn Tour *</label>
                        <select class="form-select" id="tour_id" name="tour_id" required>
                            <option value="">-- Vui lòng chọn Tour --</option>
                            <% tours.forEach(function(tour) { %>
                                <option value="<%= tour.id %>"><%= tour.name %> ($<%= tour.price %>)</option>
                            <% }); %>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label for="guests_count" class="form-label fw-bold">Số lượng khách *</label>
                        <input type="number" class="form-control" id="guests_count" name="guests_count" min="1" value="1" required>
                    </div>
                </div>
                <div class="text-center mt-2">
                    <button type="submit" class="btn btn-primary btn-lg px-5 w-100 w-md-auto shadow">Xác nhận Đặt Tour</button>
                </div>
            </form>
        </section>

        <!-- Phần 3: Bảng Khách hàng -->
        <section class="mb-5 bg-white p-4 rounded shadow-sm border border-light">
            <h2 class="mb-4 text-secondary">3. Danh sách Khách hàng đã đặt tour</h2>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Mã Đơn</th>
                            <th>Khách hàng</th>
                            <th>Email</th>
                            <th>Số ĐT</th>
                            <th>Tour đã chọn</th>
                            <th class="text-center">Số lượng</th>
                            <th>Ngày đặt</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% bookings.forEach(function(booking) { %>
                            <tr>
                                <td><span class="badge bg-secondary">#<%= booking.id %></span></td>
                                <td><strong><%= booking.customer_name %></strong></td>
                                <td><%= booking.customer_email %></td>
                                <td><%= booking.phone_number %></td>
                                <td><%= booking.tour_name %></td>
                                <td class="text-center"><%= booking.guests_count %></td>
                                <td><%= new Date(booking.booking_date).toLocaleDateString('vi-VN') %></td>
                            </tr>
                        <% }); %>
                        <% if(bookings.length === 0) { %>
                            <tr>
                                <td colspan="7" class="text-center text-muted py-4">Chưa có khách hàng nào đặt tour trong hệ thống.</td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </section>
    </div>
    
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
